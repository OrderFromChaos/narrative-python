+def gradeAgentVerbs(output: Output) -> Result:
+    if output.code == 0:
+        return Result('agentverbs', True, 'clean', output.text)
+    findings = sum(1 for line in output.text.splitlines() if ': NAR017 ' in line)
+    summary = f'{findings} findings' if findings else 'did not run (spaCy or its model missing)'
+    return Result('agentverbs', False, summary, output.text)
