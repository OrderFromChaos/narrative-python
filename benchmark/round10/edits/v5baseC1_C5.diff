diff --git a/v5baseC1_C5/reconcile/charges.py b/v5baseC1_C5/reconcile/charges.py
new file mode 100644
index 0000000..7e77390
--- /dev/null
+++ b/v5baseC1_C5/reconcile/charges.py
@@ -0,0 +1,75 @@
+"""Reader for the third finance export, `*.charges.psv`.
+
+The file has a header row, then one charge per line as four pipe-separated
+fields:
+
+    resource_id|sku|monthly_cents|region
+
+A line whose first non-whitespace character is `#` is a comment, before or
+after the header. A blank line holds nothing. Like `*.billing.csv`, the format
+carries a cost and no owning team, so each record becomes a `BillingLine` and
+joins as one.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+from . import billing
+from .model import BillingLine, MalformedInputError
+
+SUFFIX = ".charges.psv"
+SEPARATOR = "|"
+FIELD_COUNT = len(billing.COLUMNS)
+
+
+def is_charges_file(path: Path) -> bool:
+    return path.name.lower().endswith(SUFFIX)
+
+
+def read_charges_file(path: Path) -> tuple[list[BillingLine], list[str]]:
+    """Read one charges file.
+
+    Returns the lines that parsed and a message for each line that did not. A
+    bad line is skipped; the rest of the file is still read.
+
+    Raises `MalformedInputError` if the file cannot be opened, is not UTF-8
+    text, holds no header row, or has a header that is not the four names of
+    `billing.COLUMNS` in that order.
+    """
+    try:
+        text = path.read_text(encoding="utf-8")
+    except (OSError, UnicodeDecodeError) as error:
+        raise MalformedInputError(f"cannot read file: {error}") from error
+
+    records = [
+        (number, line)
+        for number, line in enumerate(text.splitlines(), start=1)
+        if line.strip() and not line.lstrip().startswith("#")
+    ]
+    if not records:
+        raise MalformedInputError("file is empty, expected a header row")
+
+    _, header_line = records[0]
+    header = tuple(name.strip().lower() for name in header_line.split(SEPARATOR))
+    if header != billing.COLUMNS:
+        raise MalformedInputError(
+            "header is not " + SEPARATOR.join(billing.COLUMNS)
+        )
+
+    lines: list[BillingLine] = []
+    problems: list[str] = []
+    for number, line in records[1:]:
+        fields = line.split(SEPARATOR)
+        if len(fields) != FIELD_COUNT:
+            problems.append(
+                f"line {number}: expected {FIELD_COUNT} pipe-separated fields, "
+                f"found {len(fields)}"
+            )
+            continue
+        row: dict[str, str | None] = dict(zip(billing.COLUMNS, fields))
+        try:
+            lines.append(billing.read_row(row, number, path.name))
+        except ValueError as error:
+            problems.append(f"line {number}: {error}")
+    return lines, problems
