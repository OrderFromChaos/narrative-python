diff --git a/pristine/v5baseC3/reconcile/join.py b/v5baseC3_R/reconcile/join.py
index d8d1568..3aaed37 100644
--- a/pristine/v5baseC3/reconcile/join.py
+++ b/v5baseC3_R/reconcile/join.py
@@ -10,6 +10,8 @@ A scanned resource whose team is in `ignored_teams` leaves the join the same
 way. A billing line carries no team, so a billing line leaves with it when its
 resource id names a scanned resource that left for its team. Without that, the
 team's own resource would come back as a `billed_not_found` finding.
+
+A record that both rules exclude counts once, as ignored for its sku.
 """
 
 from __future__ import annotations
@@ -50,23 +52,28 @@ def reconcile(
         for resource in scanned
         if rules.is_ignored_team(resource.team)
     }
+    billed_skus = [line for line in billing if not rules.is_ignored(line.sku)]
+    found_skus = [
+        resource for resource in scanned if not rules.is_ignored(resource.sku)
+    ]
     billed = {
         line.resource_id: line
-        for line in billing
-        if not rules.is_ignored(line.sku) and line.resource_id not in ignored_by_team
+        for line in billed_skus
+        if line.resource_id not in ignored_by_team
     }
     found = {
         resource.resource_id: resource
-        for resource in scanned
-        if not rules.is_ignored(resource.sku)
-        and resource.resource_id not in ignored_by_team
+        for resource in found_skus
+        if resource.resource_id not in ignored_by_team
     }
 
     stats = JoinStats(
         billing_lines=len(billing),
         scanned_resources=len(scanned),
-        ignored_billing=len(billing) - len(billed),
-        ignored_scanned=len(scanned) - len(found),
+        ignored_billing=len(billing) - len(billed_skus),
+        ignored_scanned=len(scanned) - len(found_skus),
+        team_ignored_billing=len(billed_skus) - len(billed),
+        team_ignored_scanned=len(found_skus) - len(found),
         matched=len(billed.keys() & found.keys()),
     )
 
