+def _sku_mismatches(pairs: list[tuple[BillingLine, ScannedResource]]) -> list[Finding]:
+    """Build the findings for matched pairs whose skus differ.
+
+    The skus are compared exactly, with no alias table. The finding carries
+    both skus and everything else either side supplied. It is never above the
+    grace: the resource is billed and running, so the bill is not paying for
+    nothing.
+    """
+    findings = [
+        Finding(
+            kind=FindingKind.SKU_MISMATCH,
+            resource_id=line.resource_id,
+            sku=line.sku,
+            monthly_cents=line.monthly_cents,
+            team=resource.team,
+            billed_region=line.region,
+            scanned_region=resource.region,
+            above_grace=False,
+            sources=tuple(sorted({line.source, resource.source})),
+            scanned_sku=resource.sku,
+        )
+        for line, resource in pairs
+        if line.sku != resource.sku
+    ]
+    return sorted(findings, key=lambda finding: finding.resource_id)
