--- /dev/null
+++ b/v5fullC1_C5/reconciler/charges_psv.py
@@ -0,0 +1,69 @@
+"""Read a `*.charges.psv` file from the charges export into InventoryRecords.
+
+    # exported by charges-svc
+    resource_id|sku|monthly_cents|region
+    i-0021|compute-gpu|250000|us-east-1
+
+A line whose first non-whitespace character is `#` is a comment, before or after the header. The
+first other non-blank line is the header, and a missing or wrong header stops the file. A malformed
+line is rejected on its own and counted.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+from reconciler import billing_line
+from reconciler.logs import LOG
+from reconciler.vocabulary import FileRead, InventoryFileError, InventoryFormat, InventoryLineError
+
+
+def readChargesLines(charges_path: Path) -> FileRead:
+    """Parse every line of one charges export.
+
+    Returns:
+        The accepted records in file order, and the count of lines rejected.
+
+    Raises:
+        InventoryFileError: the file could not be read, or its header is absent or not the export's header.
+    """
+    try:
+        charges_text = charges_path.read_text(encoding='utf-8')
+    except UnicodeDecodeError as exc:
+        raise _rejectChargesFile(charges_path, 'the file is not UTF-8 text') from exc
+    except OSError as exc:
+        raise _rejectChargesFile(charges_path, 'the file could not be read') from exc
+
+    # keep the header and data lines; a comment may sit on either side of the header
+    content_lines = [
+        (line_number, line)
+        for line_number, line in enumerate(charges_text.splitlines(), start=1)
+        if line.strip() and not line.lstrip().startswith('#')
+    ]
+    if not content_lines:
+        raise _rejectChargesFile(charges_path, 'the file has no header row')
+    header = [name.strip() for name in content_lines[0][1].split('|')]
+    if header != list(billing_line.BILLING_FIELDS):
+        raise _rejectChargesFile(charges_path, f'the header row is {header}, not {list(billing_line.BILLING_FIELDS)}')
+
+    records = []
+    rejected_lines = 0
+    for line_number, line in content_lines[1:]:
+        try:
+            records.append(
+                billing_line.parseBillingLine(
+                    line.split('|'),
+                    charges_path,
+                    line_number,
+                    origin=InventoryFormat.CHARGES_PSV,
+                ),
+            )
+        except InventoryLineError:
+            rejected_lines += 1
+
+    return FileRead(records=tuple(records), rejected_lines=rejected_lines)
+
+
+def _rejectChargesFile(charges_path: Path, reason: str) -> InventoryFileError:
+    LOG.debug('charges.file_rejected', extra={'path': str(charges_path), 'reason': reason})
+    return InventoryFileError(reason)
