diff --git a/v6baseC1_C5/reconciler/charges_psv.py b/v6baseC1_C5/reconciler/charges_psv.py
new file mode 100644
index 0000000..d890f93
--- /dev/null
+++ b/v6baseC1_C5/reconciler/charges_psv.py
@@ -0,0 +1,89 @@
+"""Reader for the third finance export, ``*.charges.psv``.
+
+Like the billing CSV and the ledger, the charges export carries a cost and no
+owning team, and its records are billing lines. Fields are separated by ``|``
+and read by position. Comment and blank lines may appear anywhere; the first
+line that is neither is the header, and it must be the billing CSV's four
+names in the same order.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+from .billing_csv import HEADER, read_billing_row
+from .ledger_tsv import COMMENT_MARK
+from .models import BillingLine, FileFormat, FileOutcome, FileStatus
+
+SEPARATOR = '|'
+"""The character between two fields, in the header and in every record."""
+
+HEADER_LINE = SEPARATOR.join(HEADER)
+"""The exact header line a charges file must hold before its first record."""
+
+
+def read_charges_file(
+    path: Path, accepted_resource_ids: set[str]
+) -> tuple[list[BillingLine], FileOutcome]:
+    """Read one charges file and report what became of every record line.
+
+    Args:
+        path: The file to read.
+        accepted_resource_ids: The billing side's set, shared with the billing
+            CSV and ledger readers. See :func:`~reconciler.billing_csv.read_billing_file`;
+            a ``resource_id`` already accepted from any of the three is rejected.
+
+    Returns:
+        The accepted records in file order, and the file's outcome. A file
+        whose header is missing or wrong fails as a whole and returns no
+        records.
+    """
+    outcome = FileOutcome(path=path.name, file_format=FileFormat.CHARGES, status=FileStatus.OK)
+
+    try:
+        raw_text = path.read_text(encoding='utf-8')
+    except (OSError, UnicodeDecodeError) as error:
+        outcome.status = FileStatus.FAILED
+        outcome.problems.append(f'{path.name}: unreadable ({error})')
+        return [], outcome
+
+    records: list[BillingLine] = []
+    header_seen = False
+    # Lines are split as the ledger reader splits them: on LF alone, with one
+    # trailing CR dropped, so a CRLF file reads the same.
+    for line_number, raw_line in enumerate(raw_text.split('\n'), start=1):
+        line = raw_line.removesuffix('\r')
+        content = line.strip()
+        if not content or content.startswith(COMMENT_MARK):
+            continue
+        if not header_seen:
+            if line != HEADER_LINE:
+                return [], _fail_on_header(outcome, path.name)
+            header_seen = True
+            continue
+        record = read_billing_row(
+            line.split(SEPARATOR), path.name, line_number, outcome, accepted_resource_ids
+        )
+        if record is not None:
+            records.append(record)
+            accepted_resource_ids.add(record.resource_id)
+
+    # A file of comments and blank lines alone has no header either.
+    if not header_seen:
+        return [], _fail_on_header(outcome, path.name)
+
+    if outcome.rejected:
+        outcome.status = FileStatus.PARTIAL
+    outcome.accepted = len(records)
+    return records, outcome
+
+
+def _fail_on_header(outcome: FileOutcome, source: str) -> FileOutcome:
+    """Fail the whole file because its header is absent or wrong.
+
+    Nothing is added to the shared set before the header is found, so
+    failing here leaves no trace on the files read after this one.
+    """
+    outcome.status = FileStatus.FAILED
+    outcome.problems.append(f'{source}: does not hold the header {HEADER_LINE} before its records')
+    return outcome
