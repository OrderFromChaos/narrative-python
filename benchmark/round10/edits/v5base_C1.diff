diff --git a/v5base_C1/reconcile/ledger.py b/v5base_C1/reconcile/ledger.py
new file mode 100644
index 0000000..0a8006e
--- /dev/null
+++ b/v5base_C1/reconcile/ledger.py
@@ -0,0 +1,72 @@
+"""Reader for the second finance export, `*.ledger.tsv`.
+
+The file has no header row. Each line holds one charge as four tab-separated
+fields:
+
+    resource_id<TAB>sku<TAB>monthly_cents<TAB>region
+
+A line whose first non-whitespace character is `#` is a comment. A blank line
+holds nothing. Like `*.billing.csv`, the format carries a cost and no owning
+team, so each record becomes a `BillingLine` and joins as one.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+from . import billing
+from .model import BillingLine, MalformedInputError
+
+SUFFIX = ".ledger.tsv"
+FIELD_COUNT = len(billing.COLUMNS)
+
+
+def is_ledger_file(path: Path) -> bool:
+    return path.name.lower().endswith(SUFFIX)
+
+
+def read_ledger_file(path: Path) -> tuple[list[BillingLine], list[str]]:
+    """Read one ledger file.
+
+    Returns the lines that parsed and a message for each line that did not. A
+    bad line is skipped; the rest of the file is still read. A file that holds
+    only comments and blank lines is valid and holds no records.
+
+    Raises `MalformedInputError` if the file cannot be opened, is not UTF-8
+    text, or holds record lines of which none has four tab-separated fields.
+    The last case is a file in some other format, such as a CSV export with the
+    wrong name.
+    """
+    try:
+        text = path.read_text(encoding="utf-8")
+    except (OSError, UnicodeDecodeError) as error:
+        raise MalformedInputError(f"cannot read file: {error}") from error
+
+    records = [
+        (number, line)
+        for number, line in enumerate(text.splitlines(), start=1)
+        if line.strip() and not line.lstrip().startswith("#")
+    ]
+    if records and not any(
+        len(line.split("\t")) == FIELD_COUNT for _, line in records
+    ):
+        raise MalformedInputError(
+            f"no line holds {FIELD_COUNT} tab-separated fields"
+        )
+
+    lines: list[BillingLine] = []
+    problems: list[str] = []
+    for number, line in records:
+        fields = line.split("\t")
+        if len(fields) != FIELD_COUNT:
+            problems.append(
+                f"line {number}: expected {FIELD_COUNT} tab-separated fields, "
+                f"found {len(fields)}"
+            )
+            continue
+        row: dict[str, str | None] = dict(zip(billing.COLUMNS, fields))
+        try:
+            lines.append(billing.read_row(row, number, path.name))
+        except ValueError as error:
+            problems.append(f"line {number}: {error}")
+    return lines, problems
