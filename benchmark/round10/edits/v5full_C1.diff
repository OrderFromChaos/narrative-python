diff --git a/v5full_C1/reconciler/ledger_tsv.py b/v5full_C1/reconciler/ledger_tsv.py
new file mode 100644
index 0000000..382a5a7
--- /dev/null
+++ b/v5full_C1/reconciler/ledger_tsv.py
@@ -0,0 +1,53 @@
+"""Read a `*.ledger.tsv` file from the finance ledger export into InventoryRecords.
+
+    # exported 2026-02-01 by ledger-svc
+    i-0014	compute-gpu	250000	us-east-1
+
+There is no header row. A line whose first non-whitespace character is `#` is a comment. A malformed
+line is rejected on its own and counted.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+from reconciler import billing_line
+from reconciler.logs import LOG
+from reconciler.vocabulary import FileRead, InventoryFileError, InventoryFormat, InventoryLineError
+
+
+def readLedgerLines(ledger_path: Path) -> FileRead:
+    """Parse every line of one ledger export.
+
+    Returns:
+        The accepted records in file order, and the count of lines rejected.
+
+    Raises:
+        InventoryFileError: the file could not be read.
+    """
+    try:
+        ledger_text = ledger_path.read_text(encoding='utf-8')
+    except UnicodeDecodeError as exc:
+        raise _rejectLedgerFile(ledger_path, 'the file is not UTF-8 text') from exc
+    except OSError as exc:
+        raise _rejectLedgerFile(ledger_path, 'the file could not be read') from exc
+
+    records = []
+    rejected_lines = 0
+    for line_number, line in enumerate(ledger_text.splitlines(), start=1):
+        if not line.strip() or line.lstrip().startswith('#'):
+            continue
+        fields = line.split('\t')
+        try:
+            records.append(
+                billing_line.parseBillingLine(fields, ledger_path, line_number, origin=InventoryFormat.LEDGER_TSV),
+            )
+        except InventoryLineError:
+            rejected_lines += 1
+
+    return FileRead(records=tuple(records), rejected_lines=rejected_lines)
+
+
+def _rejectLedgerFile(ledger_path: Path, reason: str) -> InventoryFileError:
+    LOG.debug('ledger.file_rejected', extra={'path': str(ledger_path), 'reason': reason})
+    return InventoryFileError(reason)
