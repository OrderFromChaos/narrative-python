index 0000000..3ec9e2f
--- /dev/null
+++ b/v5full_C1/reconciler/billing_line.py
@@ -0,0 +1,67 @@
+"""Parse the four fields of one finance billing line into an InventoryRecord.
+
+    ['i-0014', 'compute-gpu', '250000', 'us-east-1']
+    -> InventoryRecord(resource_id='i-0014', sku='compute-gpu', region='us-east-1',
+                       origin=<InventoryFormat.LEDGER_TSV: 'ledger.tsv'>, monthly_cents=250000, team=None)
+
+Both finance exports write these fields in this order. A billing line carries a cost and no owning
+team, so `team` is None on every record this module builds.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Sequence
+from pathlib import Path
+
+from reconciler.logs import LOG
+from reconciler.vocabulary import (
+    Cents,
+    InventoryFormat,
+    InventoryLineError,
+    InventoryRecord,
+    RegionName,
+    ResourceId,
+    Sku,
+)
+
+
+BILLING_FIELDS = ('resource_id', 'sku', 'monthly_cents', 'region')
+
+
+def parseBillingLine(
+    fields: Sequence[str],
+    billing_path: Path,
+    line_number: int,
+    *,
+    origin: InventoryFormat,
+) -> InventoryRecord:
+    """Build the record one billing line states.
+
+    Args:
+        billing_path: Where the line came from, for the rejection log.
+        origin: The export the line was read from.
+
+    Raises:
+        InventoryLineError: the line has the wrong field count, an empty resource_id or a non-integer cost.
+    """
+    if len(fields) != len(BILLING_FIELDS):
+        raise _rejectBillingLine(billing_path, line_number, f'{len(fields)} fields, not {len(BILLING_FIELDS)}')
+    resource_id, sku, monthly_cents, region = (field.strip() for field in fields)
+    if not resource_id:
+        raise _rejectBillingLine(billing_path, line_number, 'the resource_id is empty')
+    if not monthly_cents.removeprefix('-').isdigit():
+        raise _rejectBillingLine(billing_path, line_number, f'monthly_cents is {monthly_cents!r}, not an integer')
+
+    return InventoryRecord(
+        resource_id=ResourceId(resource_id),
+        sku=Sku(sku),
+        region=RegionName(region),
+        origin=origin,
+        monthly_cents=Cents(int(monthly_cents)),
+        team=None,
+    )
+
+
+def _rejectBillingLine(billing_path: Path, line_number: int, reason: str) -> InventoryLineError:
+    LOG.debug('billing.line_rejected', extra={'path': str(billing_path), 'line': line_number, 'reason': reason})
+    return InventoryLineError(reason)
