diff --git a/v6base_C1/reconciler/ledger_tsv.py b/v6base_C1/reconciler/ledger_tsv.py
new file mode 100644
index 0000000..cd07175
--- /dev/null
+++ b/v6base_C1/reconciler/ledger_tsv.py
@@ -0,0 +1,63 @@
+"""Reader for the second finance export, ``*.ledger.tsv``.
+
+Like the billing CSV, the ledger carries a cost and no owning team, and its
+records are billing lines. It has no header row: every line that is neither a
+comment nor blank is a record of four tab-separated fields, read by position.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+from .billing_csv import read_billing_row
+from .models import BillingLine, FileFormat, FileOutcome, FileStatus
+
+COMMENT_MARK = '#'
+"""A line whose first non-whitespace character is this is a comment."""
+
+
+def read_ledger_file(
+    path: Path, accepted_resource_ids: set[str]
+) -> tuple[list[BillingLine], FileOutcome]:
+    """Read one ledger file and report what became of every record line.
+
+    Args:
+        path: The file to read.
+        accepted_resource_ids: The billing side's set, shared with the billing
+            CSV reader. See :func:`~reconciler.billing_csv.read_billing_file`;
+            a ``resource_id`` already accepted from either format is rejected.
+
+    Returns:
+        The accepted records in file order, and the file's outcome.
+    """
+    outcome = FileOutcome(path=path.name, file_format=FileFormat.LEDGER, status=FileStatus.OK)
+
+    try:
+        raw_text = path.read_text(encoding='utf-8')
+    except (OSError, UnicodeDecodeError) as error:
+        outcome.status = FileStatus.FAILED
+        outcome.problems.append(f'{path.name}: unreadable ({error})')
+        return [], outcome
+
+    records: list[BillingLine] = []
+    # Split on LF alone and drop one trailing CR, so a CRLF file reads the same.
+    # str.splitlines() is not used: it also breaks on form feeds and other
+    # characters that are ordinary field content here.
+    for line_number, raw_line in enumerate(raw_text.split('\n'), start=1):
+        line = raw_line.removesuffix('\r')
+        # A whitespace-only line has no first non-whitespace character, so it
+        # is blank rather than a record of empty fields.
+        content = line.strip()
+        if not content or content.startswith(COMMENT_MARK):
+            continue
+        record = read_billing_row(
+            line.split('\t'), path.name, line_number, outcome, accepted_resource_ids
+        )
+        if record is not None:
+            records.append(record)
+            accepted_resource_ids.add(record.resource_id)
+
+    if outcome.rejected:
+        outcome.status = FileStatus.PARTIAL
+    outcome.accepted = len(records)
+    return records, outcome
