+def _add_missing_columns(connection: sqlite3.Connection) -> None:
+    """Bring a database written by an earlier version up to the current schema.
+
+    ``CREATE TABLE IF NOT EXISTS`` leaves an existing table as it is, so a
+    column added since must be added here. It goes on the end, which is also
+    where ``_SCHEMA`` declares it, so an upgraded table and a new one agree.
+    """
+    columns = {row[1] for row in connection.execute('PRAGMA table_info(finding)')}
+    if 'account_id' not in columns:
+        connection.execute('ALTER TABLE finding ADD COLUMN account_id TEXT')
+
+
 def _row_count(connection: sqlite3.Connection) -> int:
     return int(connection.execute('SELECT count(*) FROM finding').fetchone()[0])
